# ==============================================================================
# SERVER ENVIRONMENT TEMPLATE (Copy to .env)
# ==============================================================================

# Server Port
PORT=5001

# Environment Mode
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_mgmt

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Seeding Accounts & Passwords
DEFAULT_SUPERADMIN_EMAIL=admin@paradisepalace.com
DEFAULT_SUPERADMIN_PASSWORD=admin@123

DEFAULT_MANAGER_EMAIL=manager@paradisepalace.com
DEFAULT_MANAGER_PASSWORD=manager@123

DEFAULT_STAFF_EMAIL=staff@gmail.com
DEFAULT_STAFF_PASSWORD=staff@123

DEFAULT_CUSTOMER_EMAIL=customer@gmail.com
DEFAULT_CUSTOMER_PASSWORD=customer@123
